{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "npm:unpublishSafe",
    "schedule:daily",
    ":maintainLockFilesWeekly",
    ":disableDependencyDashboard",
    ":semanticCommits",
    ":automergeMinor",
    ":automergePr",
    ":automergeRequireAllStatusChecks",
    ":label(area: dependencies)"
  ],
  "baseBranches": ["main", "experimental"],
  "prHourlyLimit": 20,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the stable Maven-owned Seed4J version",
      "managerFilePatterns": ["/^pom\\.xml$/"],
      "matchStrings": [
        "<!-- renovate: datasource=maven depName=com\\.seed4j:seed4j-engine -->[\\s\\S]*?<seed4j\\.version>(?<currentValue>[^<]+)</seed4j\\.version>"
      ],
      "datasourceTemplate": "maven",
      "depNameTemplate": "com.seed4j:seed4j-engine",
      "versioningTemplate": "maven"
    }
  ],
  "packageRules": [
    {
      "description": "Update shared dependencies only on main",
      "matchBaseBranches": ["experimental"],
      "enabled": false
    },
    {
      "description": "Track official Seed4J releases on main",
      "matchBaseBranches": ["main"],
      "matchDatasources": ["maven"],
      "matchPackageNames": ["com.seed4j:seed4j-engine"],
      "ignoreUnstable": true,
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps",
      "matchManagers": ["custom.regex"]
    },
    {
      "description": "Use only the regex updater for official Seed4J modules on main",
      "matchBaseBranches": ["main"],
      "matchManagers": ["maven"],
      "matchPackageNames": ["com.seed4j:seed4j-engine", "com.seed4j:seed4j-core-modules", "com.seed4j:seed4j-test"],
      "enabled": false
    },
    {
      "description": "Track personal Seed4J snapshots on experimental",
      "matchBaseBranches": ["experimental"],
      "matchDatasources": ["maven"],
      "matchManagers": ["maven"],
      "matchPackageNames": ["io.github.renanfranca:seed4j-core-modules"],
      "registryUrls": ["https://central.sonatype.com/repository/maven-snapshots/"],
      "ignoreUnstable": false,
      "automerge": true,
      "automergeType": "pr",
      "rebaseWhen": "behind-base-branch",
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps",
      "enabled": true
    }
  ],
  "docker-compose": {
    "fileMatch": ["^src/main/docker/[^/]*\\.ya?ml$"]
  }
}
