{
  "name": "seed4j-cli",
  "version": "0.0.0-SNAPSHOT",
  "private": false,
  "description": "Seed4J CLI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seed4j/seed4j-cli.git"
  },
  "license": "Apache-2.0",
  "bin": {
    "seed4j": "./bin/seed4j.js"
  },
  "files": [
    "bin/",
    "documentation/",
    "dist/seed4j-cli.jar",
    "LICENSE.txt",
    "README.md"
  ],
  "scripts": {
    "package:prepare": "node scripts/prepare-npm-package.js",
    "prepare": "husky",
    "prettier:check": "prettier --check .",
    "prettier:format": "prettier --write .",
    "test:npm-package": "node --test test/npm/*.test.js",
    "test:npm-packed-skill": "node tests-ci/npm-packed-skill.js",
    "test:release": "node --test test/release/*.test.js",
    "test:workflows": "node --test test/workflows/*.test.js"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@prettier/plugin-xml": "3.4.2",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "conventional-changelog-conventionalcommits": "10.4.0",
    "husky": "9.1.7",
    "lint-staged": "17.5.0",
    "prettier": "3.9.6",
    "prettier-plugin-gherkin": "4.0.0",
    "prettier-plugin-java": "2.10.3",
    "prettier-plugin-organize-imports": "4.3.0",
    "prettier-plugin-packagejson": "3.0.2",
    "semantic-release": "25.0.9"
  },
  "engines": {
    "node": ">=22"
  }
}
